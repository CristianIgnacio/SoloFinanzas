APP_ENV=development
DATABASE_URL=sqlite:///data/cloud_dev.db
# Production: postgresql+psycopg://ROLE.PROJECT:PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Only the backend; required for account deletion. Use a modern sb_secret_ key.
# Never use VITE_ for secrets. Legacy SUPABASE_SERVICE_ROLE_KEY is supported as fallback.
SUPABASE_SECRET_KEY=
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
